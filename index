<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Catálogo de productos</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <div class="app">
    <header class="app__header">
      <div class="app__brand">
        <span class="app__logo" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></span>
        <div>
          <h1 class="app__title">Gestión de productos</h1>
          <p class="app__subtitle">Registra y organiza tu catálogo</p>
        </div>
      </div>
    </header>

    <main class="app__main">
      <section class="panel panel--form" aria-labelledby="form-title">
        <div class="card card--form">
          <h2 id="form-title" class="card__title">
            <i class="fa-solid fa-plus-circle card__title-icon" aria-hidden="true"></i>
            Nuevo producto
          </h2>
          <form id="product-form" class="form" novalidate>
            <div class="form__group">
              <label class="form__label" for="product-name">Nombre del producto</label>
              <input
                class="form__input"
                type="text"
                id="product-name"
                name="name"
                placeholder="Ej. Auriculares Bluetooth"
                autocomplete="off"
              />
              <span class="form__error" id="error-name" role="alert"></span>
            </div>
            <div class="form__group">
              <label class="form__label" for="product-detail">Detalle</label>
              <textarea
                class="form__textarea"
                id="product-detail"
                name="detail"
                rows="4"
                placeholder="Descripción breve del producto..."
              ></textarea>
              <span class="form__error" id="error-detail" role="alert"></span>
            </div>
            <div class="form__group">
              <label class="form__label" for="product-value">Valor</label>
              <div class="form__input-wrap">
                <span class="form__currency" aria-hidden="true">$</span>
                <input
                  class="form__input form__input--currency"
                  type="text"
                  id="product-value"
                  name="value"
                  inputmode="decimal"
                  placeholder="0,00"
                  autocomplete="off"
                />
              </div>
              <span class="form__error" id="error-value" role="alert"></span>
            </div>
            <button type="submit" class="btn btn--primary">
              <i class="fa-solid fa-cart-plus" aria-hidden="true"></i>
              Agregar Producto
            </button>
          </form>
        </div>
      </section>

      <section class="panel panel--showcase" aria-labelledby="showcase-title">
        <div class="showcase-header">
          <h2 id="showcase-title" class="showcase-header__title">
            <i class="fa-solid fa-store showcase-header__icon" aria-hidden="true"></i>
            Vitrina
          </h2>
          <span class="showcase-header__count" id="product-count">0 productos</span>
        </div>

        <div id="empty-state" class="empty-state" hidden>
          <div class="empty-state__illustration">
            <i class="fa-solid fa-box-open" aria-hidden="true"></i>
          </div>
          <p class="empty-state__text">Tu catálogo está vacío</p>
          <p class="empty-state__hint">Agrega un producto usando el formulario</p>
        </div>

        <div id="product-grid" class="product-grid" aria-live="polite"></div>
      </section>
    </main>
  </div>

  <script src="app.js"></script>
</body>
</html>
